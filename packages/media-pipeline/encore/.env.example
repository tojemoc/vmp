# Copy to encore/.env (or point VMP_ENV_FILE) before `docker compose up`.
# Compose fails fast if required vars below are missing — do not leave placeholders.

VMP_WEBHOOK_SECRET=replace-with-d1-podcast_rebuild_webhook_secret
# base64url only (A–Z a–z 0–9 - _) — embedded in encore-packager CALLBACK_URL Basic auth
VMP_PACKAGER_SECRET=replace-with-base64url-secret
VMP_SUPERVISOR_DASHBOARD_SECRET=replace-with-long-random-string

VMP_API_BASE_URL=https://api.example.com
VMP_API_PIPELINE_SECRET=replace-with-worker-pipeline-secret

# Object storage (private B2 — same bucket for packager + supervisor sidecars).
# encore-packager reads AWS_* / S3_ENDPOINT_URL; supervisor uses STORAGE_PROVIDER=b2
# + S3_BUCKET_NAME (or B2_BUCKET_NAME / PACKAGE_OUTPUT_FOLDER) via @vmp/storage.
STORAGE_PROVIDER=b2
PACKAGE_OUTPUT_FOLDER=s3://your-b2-bucket/videos
# Same bucket name as PACKAGE_OUTPUT_FOLDER — read by createStorageProviderFromEnv
S3_BUCKET_NAME=your-b2-bucket
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
AWS_ACCESS_KEY_ID=your-b2-key-id
AWS_SECRET_ACCESS_KEY=your-b2-application-key
AWS_REGION=eu-central-003
B2_ACCESS_KEY_ID=your-b2-key-id
B2_SECRET_ACCESS_KEY=your-b2-application-key
B2_REGION=eu-central-003
S3_FORCE_PATH_STYLE=1
# Optional aliases (Compose maps B2_* into AWS_* when AWS_* unset):
# B2_BUCKET_NAME=your-b2-bucket
# B2_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# HLS segment duration for encore-packager / Shaka (seconds). Keep aligned with
# Encore profile GOP (g/keyint_min = fps * seconds → 60 @ 30fps for 2s segments).
# PACKAGE_FORMAT_OPTIONS_JSON={"segmentDuration":2}
# Optional override (default embeds VMP_PACKAGER_SECRET as Basic auth password):
# PACKAGER_CALLBACK_URL=http://vmp:YOUR_PACKAGER_SECRET@vmp-supervisor:8788/vmp/api

# Host supervisor + Docker packager: rewrite Encore job URLs for packager DNS
# PACKAGER_ENCORE_BASE_URL=http://encore-web:8080
# (Compose sets this automatically when supervisor runs in the stack.)

# Host bind for dashboard + Worker webhooks (default loopback-only)
# VMP_UI_BIND=127.0.0.1:8788
# VMP_UI_BIND=0.0.0.0:8788

# TrueNAS / NFS mapall — run media containers as that UID:GID
# MEDIA_USER=3000:3000
# Then: docker compose -f docker-compose.yml -f docker-compose.nfs.yml up -d
# Scaled workers also need: -f docker-compose.scale.yml -f docker-compose.scale.nfs.yml

# Horizontal encode scale (npm run encore:up:scale):
# ENCORE_WORKER_HIGH_REPLICAS=3
# ENCORE_WORKER_LOW_REPLICAS=2
# ENCORE_PACKAGER_REPLICAS=3
# ENCORE_WORKER_IDLE_SLEEP_S=5
# Optional intra-job parallel encode (Encore segmented encode; GOP-aligned seconds):
# ENCORE_SEGMENT_LENGTH_SECONDS=120

# Pin a specific GHCR build instead of :latest
# VMP_SUPERVISOR_IMAGE=ghcr.io/tojemoc/vmp-media-pipeline:sha-abc1234
