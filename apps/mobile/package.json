{
  "name": "@vmp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:tv": "EXPO_TV=1 expo start --android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean --no-install",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./app ./src",
    "test": "tsx --test test/**/*.test.ts"
  },
  "overrides": {
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.10.4",
    "decode-uri-component": ">=0.5.0",
    "uuid": ">=11.1.1"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.3",
    "@dr.pogodin/react-native-static-server": "^0.28.0",
    "@vmp/shared": "file:../../packages/shared",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.13",
    "expo-file-system": "~57.0.0",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "react": "19.3.0",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.3.0",
    "pod-install": "1.1.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0"
  }
}
